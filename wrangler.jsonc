{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fortune",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  }
}
